{
  "name": "@deot/vc",
  "version": "1.2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./full": {
      "import": "./dist/index.full.js",
      "require": "./dist/index.full.cjs",
      "types": "./types/entry.d.ts"
    },
    "./desktop": {
      "import": "./dist/index.desktop.js",
      "require": "./dist/index.desktop.cjs",
      "types": "./types/entry.d.ts"
    },
    "./mobile": {
      "import": "./dist/index.mobile.js",
      "require": "./dist/index.mobile.cjs",
      "types": "./types/entry.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "full": [
        "./types/entry.d.ts"
      ],
      "desktop": [
        "./types/entry.d.ts"
      ],
      "mobile": [
        "./types/entry.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "types"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@deot/vc-components": "^1.2.0",
    "@deot/vc-hooks": "^1.2.0",
    "@deot/vc-locale": "^1.2.0",
    "@deot/vc-shared": "^1.2.0"
  },
  "peerDependencies": {
    "vue": "*"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  }
}